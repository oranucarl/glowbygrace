{
  "expo": {
    "name": "Glow by Grace",
    "slug": "glowbygrace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.glowbygrace.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2a1a14",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.glowbygrace.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-sqlite",
      "expo-web-browser",
      "expo-image",
      "expo-font",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#2a1a14"
        }
      ]
    ],
    "scheme": "glowbygrace",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c5d28192-a927-464b-9967-855c4d6fa278"
      }
    },
    "owner": "oranucarl"
  }
}
