{"password_min_length": 8, "mailer_subjects_confirmation": "Confirm your Glow by Grace account", "mailer_templates_confirmation_content": "<!doctype html><html><body style=\"margin:0;padding:0;background:#f7f0e7;font-family:Helvetica,Arial,sans-serif;color:#2a1a14\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f7f0e7\"><tr><td align=\"center\" style=\"padding:28px 12px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;background:#fffdfa;border-radius:18px;overflow:hidden\">\n<tr><td style=\"background:#2a1a14;padding:24px 28px;text-align:center\"><div style=\"font-family:Georgia,serif;font-size:26px;color:#f7f0e7\">Glow <span style=\"color:#c49a5a;font-style:italic\">by</span> Grace</div></td></tr>\n<tr><td style=\"padding:30px 28px\">\n<div style=\"font-size:12px;letter-spacing:3px;text-transform:uppercase;font-weight:700;color:#c49a5a\">Welcome</div>\n<h1 style=\"font-family:Georgia,serif;font-weight:400;font-size:28px;margin:10px 0 12px\">Confirm your email</h1>\n<p style=\"font-size:15px;line-height:1.6;color:#6b4636;margin:0 0 24px\">Thanks for creating a Glow by Grace account. Tap the button below to confirm <b>{{ .Email }}</b> and you'll be signed straight in.</p>\n<a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#2a1a14;color:#f7f0e7;text-decoration:none;padding:14px 26px;border-radius:999px;font-weight:700;font-size:13px;letter-spacing:1.5px;text-transform:uppercase\">Confirm my email</a>\n<p style=\"font-size:13px;line-height:1.6;color:#8a7366;margin:24px 0 0\">Didn't sign up? You can safely ignore this email.</p>\n</td></tr>\n<tr><td style=\"background:#efe4d6;padding:18px 28px;text-align:center;font-size:12px;color:#8a7366;line-height:1.6\">Questions? WhatsApp us on 0814 398 5557.<br>\u00a9 Glow by Grace \u00b7 Lagos, Nigeria</td></tr>\n</table></td></tr></table></body></html>", "mailer_subjects_recovery": "Set your Glow by Grace password", "mailer_templates_recovery_content": "<!doctype html><html><body style=\"margin:0;padding:0;background:#f7f0e7;font-family:Helvetica,Arial,sans-serif;color:#2a1a14\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"background:#f7f0e7\"><tr><td align=\"center\" style=\"padding:28px 12px\">\n<table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:560px;background:#fffdfa;border-radius:18px;overflow:hidden\">\n<tr><td style=\"background:#2a1a14;padding:24px 28px;text-align:center\"><div style=\"font-family:Georgia,serif;font-size:26px;color:#f7f0e7\">Glow <span style=\"color:#c49a5a;font-style:italic\">by</span> Grace</div></td></tr>\n<tr><td style=\"padding:30px 28px\">\n<div style=\"font-size:12px;letter-spacing:3px;text-transform:uppercase;font-weight:700;color:#c49a5a\">Password</div>\n<h1 style=\"font-family:Georgia,serif;font-weight:400;font-size:28px;margin:10px 0 12px\">Set a new password</h1>\n<p style=\"font-size:15px;line-height:1.6;color:#6b4636;margin:0 0 24px\">We received a request to set a password for the Glow by Grace account <b>{{ .Email }}</b>. Tap the button below to choose one. The link expires in 1 hour.</p>\n<a href=\"{{ .ConfirmationURL }}\" style=\"display:inline-block;background:#2a1a14;color:#f7f0e7;text-decoration:none;padding:14px 26px;border-radius:999px;font-weight:700;font-size:13px;letter-spacing:1.5px;text-transform:uppercase\">Set my password</a>\n<p style=\"font-size:13px;line-height:1.6;color:#8a7366;margin:24px 0 0\">Didn't ask for this? Ignore this email \u2014 your account stays as it is.</p>\n</td></tr>\n<tr><td style=\"background:#efe4d6;padding:18px 28px;text-align:center;font-size:12px;color:#8a7366;line-height:1.6\">Questions? WhatsApp us on 0814 398 5557.<br>\u00a9 Glow by Grace \u00b7 Lagos, Nigeria</td></tr>\n</table></td></tr></table></body></html>"}